# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api
FRONTEND_ORIGIN=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campushub

# Auth (generate a long random string for production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_RESET_EXPIRES_IN=30m
BCRYPT_ROUNDS=10

# File storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
STORAGE_PROVIDER=local
# Set STORAGE_PROVIDER=s3 to store new uploads in a private S3 bucket.
S3_BUCKET=
S3_REGION=
# Optional when the runtime has an AWS IAM role; set both together otherwise.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional S3-compatible endpoint (for example, MinIO or another compatible service).
S3_ENDPOINT=

# Email (leave blank to log emails to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CampusHub <noreply@campushub.local>"

# Optional web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campushub.local

# Optional assistant (keys stay on the server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Institution
INSTITUTION_NAME=CampusHub College
